# ─────────────────────────────────────────────
#  .gitignore GLOBAL — COMPUTEKNO (raíz)
#  Protege todo el proyecto: backend y frontend
# ─────────────────────────────────────────────

# Dependencias instaladas
node_modules/
dist/
build/

# Variables de entorno (NUNCA subir secretos)
.env
.env.*
!.env.example

# Archivos de sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/

# Logs y temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp

# Configuración local de entorno (si usas algún día)
config.local.json
